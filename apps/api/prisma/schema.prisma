generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Aligns with packages/fixtures/transport/state-transitions.json (DeliveryStateMachine).
enum DeliveryState {
  LOCAL_SAVED
  PEER_RECEIVED
  SERVER_ACCEPTED
  OPERATOR_SEEN
  CASE_IN_PROGRESS
  FAILED
  EXPIRED
}

/// packages/contracts/schemas/common.schema.json#/definitions/incidentState
enum IncidentState {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

/// ADR-011 (feature branch): UNKNOWN/GPS/MANUAL — TODO sync enum when contract lands on main.
enum LocationStatus {
  UNKNOWN
  GPS
  MANUAL
}

/// SOS category — TODO bind to packages/contracts when SOS type schema is on main.
enum SosType {
  GENERAL
  MEDICAL
  TRAPPED
  FIRE
  OTHER
}

enum UserRole {
  OPERATOR
  ADMIN
  COORDINATOR
}

enum ResourceKind {
  FIELD_TEAM
  VEHICLE
  EQUIPMENT
  SHELTER
}

enum WorkTaskStatus {
  PROPOSED
  ASSIGNED
  ACCEPTED
  WITHDRAWN
  CLOSED
}

enum WorkTaskSource {
  MANUAL
  AI
}

enum AssignmentRecommendationStatus {
  PROPOSED
  REJECTED
  CONFIRMED
}

enum RecommendationFeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

enum NotificationDeliveryState {
  PENDING
  DELIVERED
  SKIPPED_QUIET_HOURS
  FAILED
}

enum OperatorReviewStatus {
  NEW
  SEEN
  UNDER_REVIEW
  COORDINATING
}

model Incident {
  id            String               @id @default(uuid()) @db.Uuid
  state         IncidentState        @default(PENDING)
  reviewStatus  OperatorReviewStatus @default(NEW) @map("review_status")
  version       Int                  @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  sosMessages SosMessage[]
  assignments Assignment[]
  aiAnalyses  AiAnalysis[]
  auditLogs   AuditLog[]
  workTasks                 WorkTask[]
  assignmentRecommendations AssignmentRecommendation[]
  attachments               Attachment[]
  incidentLinksA            IncidentLinkSuggestion[] @relation("IncidentLinkA")
  incidentLinksB            IncidentLinkSuggestion[] @relation("IncidentLinkB")
  /// Mesh v2: the sender whose messages are merged into this incident (null for v1 / unknown sender).
  senderId           String?    @map("sender_id") @db.Uuid
  sender             SosSender? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  /// Mesh v2: newest precise location across merged messages (by inner location.timestamp).
  latestLatitude     Decimal?   @map("latest_latitude") @db.Decimal(10, 7)
  latestLongitude    Decimal?   @map("latest_longitude") @db.Decimal(10, 7)
  latestAccuracyMeters Float?   @map("latest_accuracy_meters")
  latestLocationAt   DateTime?  @map("latest_location_at")
  mergedMessageCount Int        @default(1) @map("merged_message_count")
  lastMessageAt      DateTime?  @map("last_message_at")

  @@index([senderId, updatedAt(sort: Desc)], map: "incidents_sender_id_updated_at_idx")
  @@map("incidents")
}

model SosMessage {
  id                  String         @id @default(uuid()) @db.Uuid
  messageId           String         @unique @map("message_id")
  incidentId          String         @map("incident_id") @db.Uuid
  incident            Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  deliveryState       DeliveryState  @default(LOCAL_SAVED) @map("delivery_state")
  sosType             SosType        @default(GENERAL) @map("sos_type")
  locationStatus      LocationStatus @default(UNKNOWN) @map("location_status")
  latitude            Decimal?       @db.Decimal(10, 7)
  longitude           Decimal?       @db.Decimal(10, 7)
  accuracyMeters      Float?         @map("accuracy_meters")
  preciseLatitude     Decimal?       @map("precise_latitude") @db.Decimal(10, 7)
  preciseLongitude    Decimal?       @map("precise_longitude") @db.Decimal(10, 7)
  preciseAccuracyMeters Float?       @map("precise_accuracy_meters")
  preciseCapturedAt   DateTime?      @map("precise_captured_at")
  /// Sensitive note: encrypted/opaque at rest (ADIM 9); must not appear in logs.
  encryptedNoteBlob   String?        @map("encrypted_note_blob") @db.Text
  encryptedPayloadRef String?        @map("encrypted_payload_ref")
  /// Original envelope JSON (canonical) for AAD verification during decryption
  originalEnvelopeAad String?        @map("original_envelope_aad") @db.Text
  /// Plaintext note (decrypted server-side when keyId matches production key)
  noteText            String?        @map("note_text") @db.Text
  personCount         Int?           @map("person_count")
  /// Synthetic operator-visible SOS text (M0 fixtures); not raw PII from devices.
  operatorDisplayText String?        @map("operator_display_text") @db.Text
  /// Marks synthetic/demo data created via operator API (not from real device)
  synthetic           Boolean        @default(false)
  priority            Int            @default(3)
  receivedAt          DateTime       @default(now()) @map("received_at")
  serverReceiptAt     DateTime?      @map("server_receipt_at")
  needsHumanReview    Boolean        @default(false) @map("needs_human_review")
  packetHash          String?        @map("packet_hash") @db.VarChar(64)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  messageEvents       MessageEvent[]
  relayReceipts       RelayReceipt[]
  attachments         Attachment[]
  /// Mesh v2: sender identity (hash only, see SosSender). Null for v1 messages.
  senderId            String?        @map("sender_id") @db.Uuid
  sender              SosSender?     @relation(fields: [senderId], references: [id], onDelete: SetNull)
  /// Inner payload version (2 for mesh v2, null for v1 / undecryptable).
  innerVersion        Int?           @map("inner_version") @db.SmallInt
  senderSeq           BigInt?        @map("sender_seq")

  @@index([incidentId])
  @@index([senderId, receivedAt(sort: Desc)], map: "sos_messages_sender_id_received_at_idx")
  @@index([priority, receivedAt(sort: Desc)], map: "sos_messages_priority_received_at_idx")
  @@index([receivedAt(sort: Desc)], map: "sos_messages_received_at_idx")
  @@map("sos_messages")
}

model MessageEvent {
  id            String        @id @default(uuid()) @db.Uuid
  sosMessageId  String        @map("message_id") @db.Uuid
  sosMessage    SosMessage    @relation(fields: [sosMessageId], references: [id], onDelete: Cascade)
  deliveryState DeliveryState @map("delivery_state")
  source        String
  createdAt     DateTime      @default(now()) @map("created_at")
  metadataJson  Json?         @map("metadata_json")

  @@index([sosMessageId, createdAt])
  @@map("message_events")
}

model RelayReceipt {
  id           String     @id @default(uuid()) @db.Uuid
  sosMessageId String     @map("message_id") @db.Uuid
  sosMessage   SosMessage @relation(fields: [sosMessageId], references: [id], onDelete: Cascade)
  relayId      String     @map("relay_id")
  receivedAt   DateTime   @default(now()) @map("received_at")
  hopCount     Int        @default(0) @map("hop_count")
  receiptHash  String?    @map("receipt_hash")

  @@unique([sosMessageId, relayId])
  @@map("relay_receipts")
}

model AiAnalysis {
  id                   String    @id @default(uuid()) @db.Uuid
  incidentId           String    @map("incident_id") @db.Uuid
  incident             Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  modelVersion         String    @map("model_version")
  resultJson           Json      @map("result_json")
  status               String    @default("PENDING")
  eventType            String?   @map("event_type")
  reportedPersonCount  Int?      @map("reported_person_count")
  needs                Json      @default("[]")
  hazards              Json      @default("[]")
  urgencySuggestion    String?   @map("urgency_suggestion")
  missingInfo          Json      @default("[]") @map("missing_info")
  summary              String?   @db.Text
  nextStepSuggestion   String?   @map("next_step_suggestion") @db.Text
  sourceQuotes         Json      @default("[]") @map("source_quotes")
  translation          Json?
  followUpQuestions    Json      @default("[]") @map("follow_up_questions")
  operatorOverride     Json?     @map("operator_override")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([incidentId])
  @@index([status], map: "ai_analyses_status_idx")
  @@index([urgencySuggestion], map: "ai_analyses_urgency_idx")
  @@map("ai_analyses")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  teams     Team[]
  resources Resource[]

  @@map("organizations")
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  type           String?
  capacity       Int?
  contactInfo    String?      @map("contact_info")
  status         String?
  zoneCode       String?      @map("zone_code")
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")
  users          User[]
  assignments    Assignment[]
  resources      Resource[]
  workTasks      WorkTask[]
  locationShares LocationShareGrant[]
  assignmentRecommendations AssignmentRecommendation[]

  @@index([organizationId])
  @@map("teams")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  displayName  String       @map("display_name")
  passwordHash String?      @map("password_hash")
  role         UserRole     @default(OPERATOR)
  teamId       String?      @map("team_id") @db.Uuid
  team        Team?        @relation(fields: [teamId], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  assignments     Assignment[]
  auditLogs       AuditLog[]
  workTasksOwned  WorkTask[]             @relation("WorkTaskAssignee")
  locationShares  LocationShareGrant[]
  notifications   OperatorNotification[]
  notifyPrefs              NotificationPreference?
  recommendationFeedback   RecommendationFeedback[]
  incidentLinkDecisions    IncidentLinkSuggestion[]

  @@map("users")
}

model Assignment {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  teamId     String   @map("team_id") @db.Uuid
  team       Team     @relation(fields: [teamId], references: [id])
  assigneeId String?  @map("assignee_id") @db.Uuid
  assignee   User?    @relation(fields: [assigneeId], references: [id])
  status     String   @default("OPEN")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([incidentId])
  @@index([teamId])
  @@map("assignments")
}

model Resource {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  teamId         String?      @map("team_id") @db.Uuid
  team           Team?        @relation(fields: [teamId], references: [id])
  kind           ResourceKind
  name           String
  capacity       Int          @default(1)
  zoneCode       String?      @map("zone_code")
  availableFrom  DateTime?    @map("available_from")
  availableUntil DateTime?    @map("available_until")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  workTasks      WorkTask[]
  assignmentRecommendations AssignmentRecommendation[]

  @@index([organizationId])
  @@index([teamId])
  @@map("resources")
}

model WorkTask {
  id          String         @id @default(uuid()) @db.Uuid
  incidentId  String         @map("incident_id") @db.Uuid
  incident    Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  teamId      String         @map("team_id") @db.Uuid
  team        Team           @relation(fields: [teamId], references: [id])
  resourceId  String?        @map("resource_id") @db.Uuid
  resource    Resource?      @relation(fields: [resourceId], references: [id])
  assigneeId  String?        @map("assignee_id") @db.Uuid
  assignee    User?          @relation("WorkTaskAssignee", fields: [assigneeId], references: [id])
  title       String
  description String?        @db.Text
  status      WorkTaskStatus @default(PROPOSED)
  source      WorkTaskSource @default(MANUAL)
  version     Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  confirmedRecommendation AssignmentRecommendation?

  @@index([incidentId])
  @@index([teamId])
  @@index([status])
  @@map("work_tasks")
}

/// Time-limited operator location share (no coordinates in audit_logs).
model LocationShareGrant {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String    @map("team_id") @db.Uuid
  team      Team      @relation(fields: [teamId], references: [id])
  expiresAt DateTime  @map("expires_at")
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)

  @@index([userId, expiresAt])
  @@index([teamId])
  @@map("location_share_grants")
}

model OperatorNotification {
  id             String                    @id @default(uuid()) @db.Uuid
  userId         String                    @map("user_id") @db.Uuid
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String                    @map("organization_id") @db.Uuid
  dedupeKey      String                    @map("dedupe_key")
  eventType      String                    @map("event_type")
  title          String
  body           String                    @db.Text
  deliveryState  NotificationDeliveryState @default(PENDING) @map("delivery_state")
  readAt         DateTime?                 @map("read_at")
  createdAt      DateTime                  @default(now()) @map("created_at")

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("operator_notifications")
}

model NotificationPreference {
  userId           String  @id @map("user_id") @db.Uuid
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppEnabled     Boolean @default(true) @map("in_app_enabled")
  emailEnabled     Boolean @default(false) @map("email_enabled")
  quietHoursStart  Int?    @map("quiet_hours_start")
  quietHoursEnd    Int?    @map("quiet_hours_end")
  timezoneOffsetMin Int    @default(180) @map("timezone_offset_min")

  @@map("notification_preferences")
}

model NotificationSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventType String   @map("event_type")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, eventType])
  @@map("notification_subscriptions")
}

model OperatorFeedEvent {
  seq            BigInt         @id @default(autoincrement())
  messageId      String         @map("message_id")
  incidentId     String         @map("incident_id") @db.Uuid
  priority       Int
  locationStatus LocationStatus @map("location_status")
  latitude       Decimal?       @db.Decimal(10, 7)
  longitude      Decimal?       @db.Decimal(10, 7)
  occurredAt     DateTime       @map("occurred_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@unique([messageId])
  @@index([seq])
  @@map("operator_feed_events")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorId     String?   @map("actor_id") @db.Uuid
  actor       User?     @relation(fields: [actorId], references: [id])
  incidentId  String?   @map("incident_id") @db.Uuid
  incident    Incident? @relation(fields: [incidentId], references: [id])
  action      String
  detailsJson Json?     @map("details_json")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([incidentId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// ADIM 46: deterministic resource matching draft; commit only via coordinator confirm.
model AssignmentRecommendation {
  id                 String                         @id @default(uuid()) @db.Uuid
  incidentId         String                         @map("incident_id") @db.Uuid
  incident           Incident                       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  teamId             String                         @map("team_id") @db.Uuid
  team               Team                           @relation(fields: [teamId], references: [id])
  resourceId         String?                        @map("resource_id") @db.Uuid
  resource           Resource?                      @relation(fields: [resourceId], references: [id])
  rank               Int                            @default(0)
  distanceKm         Float?                         @map("distance_km")
  available          Boolean                        @default(false)
  status             AssignmentRecommendationStatus @default(PROPOSED)
  deterministicNote  String                         @map("deterministic_note") @db.Text
  aiRationale        String?                        @map("ai_rationale") @db.Text
  missingInfoJson    Json                           @map("missing_info_json")
  dataFreshnessJson  Json                           @map("data_freshness_json")
  workTaskId         String?                        @unique @map("work_task_id") @db.Uuid
  workTask           WorkTask?                      @relation(fields: [workTaskId], references: [id])
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")
  feedback           RecommendationFeedback[]

  @@index([incidentId, status])
  @@index([teamId])
  @@map("assignment_recommendations")
}

model RecommendationFeedback {
  id               String                       @id @default(uuid()) @db.Uuid
  recommendationId String                       @map("recommendation_id") @db.Uuid
  recommendation   AssignmentRecommendation     @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  actorId          String                       @map("actor_id") @db.Uuid
  actor            User                         @relation(fields: [actorId], references: [id])
  rating           RecommendationFeedbackRating
  note             String?                      @db.Text
  capturedForScoring Boolean                    @default(true) @map("captured_for_scoring")
  createdAt        DateTime                     @default(now()) @map("created_at")

  @@index([recommendationId])
  @@map("recommendation_feedback")
}

enum AiJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REQUIRES_REVIEW
  UNAVAILABLE
}

enum AttachmentKind {
  AUDIO
  PHOTO
}

enum IncidentLinkStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
}

model AiJob {
  id              String      @id @default(uuid()) @db.Uuid
  kind            String
  incidentId      String?     @map("incident_id") @db.Uuid
  sosMessageId    String?     @map("sos_message_id") @db.Uuid
  attachmentId    String?     @map("attachment_id") @db.Uuid
  idempotencyKey  String      @unique @map("idempotency_key")
  status          String      @default("PENDING")
  attempts        Int         @default(0)
  lastError       String?     @map("last_error") @db.Text
  createdAt       DateTime    @default(now()) @map("created_at")
  startedAt       DateTime?   @map("started_at")
  completedAt     DateTime?   @map("completed_at")

  @@index([status, createdAt], map: "ai_jobs_status_created_at_idx")
  @@index([incidentId], map: "ai_jobs_incident_id_idx")
  @@index([sosMessageId], map: "ai_jobs_sos_message_id_idx")
  @@map("ai_jobs")
}

model AiUsageLedger {
  id           String   @id @default(uuid()) @db.Uuid
  day          DateTime @db.Date
  model        String   @db.VarChar(100)
  reservedUsd  Decimal  @default(0) @map("reserved_usd") @db.Decimal(10, 4)
  actualUsd    Decimal  @default(0) @map("actual_usd") @db.Decimal(10, 4)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([day, model], map: "ai_usage_ledger_day_model_idx")
  @@map("ai_usage_ledger")
}

model Attachment {
  id              String              @id @default(uuid()) @db.Uuid
  incidentId      String              @map("incident_id") @db.Uuid
  incident        Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  sosMessageId    String?             @map("sos_message_id") @db.Uuid
  sosMessage      SosMessage?         @relation(fields: [sosMessageId], references: [id], onDelete: SetNull)
  kind            String
  mime            String              @db.VarChar(100)
  sizeBytes       Int                 @map("size_bytes")
  durationMs      Int?                @map("duration_ms")
  storageKey      String              @map("storage_key") @db.VarChar(500)
  sha256          String              @db.VarChar(64)
  synthetic       Boolean             @default(false)
  createdAt       DateTime            @default(now()) @map("created_at")
  expiresAt       DateTime?           @map("expires_at")
  transcript      AiTranscript?
  visionAnalysis  AiVisionAnalysis?

  @@index([incidentId], map: "attachments_incident_id_idx")
  @@index([sosMessageId], map: "attachments_sos_message_id_idx")
  @@index([storageKey], map: "attachments_storage_key_idx")
  @@index([expiresAt], map: "attachments_expires_at_idx")
  @@map("attachments")
}

model AiTranscript {
  id              String      @id @default(uuid()) @db.Uuid
  attachmentId    String      @unique @map("attachment_id") @db.Uuid
  attachment      Attachment  @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  model           String      @db.VarChar(100)
  transcript      String      @db.Text
  turns           Json        @default("[]")
  language        String?     @db.VarChar(10)
  audioDurationMs Int?        @map("audio_duration_ms")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@map("ai_transcripts")
}

model AiVisionAnalysis {
  id           String      @id @default(uuid()) @db.Uuid
  attachmentId String      @unique @map("attachment_id") @db.Uuid
  attachment   Attachment  @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  sparkSummary Json        @map("spark_summary")
  samResults   Json        @default("[]") @map("sam_results")
  sparkModel   String      @map("spark_model") @db.VarChar(100)
  samModel     String?     @map("sam_model") @db.VarChar(100)
  createdAt    DateTime    @default(now()) @map("created_at")

  @@map("ai_vision_analyses")
}

model IncidentLinkSuggestion {
  id                    String    @id @default(uuid()) @db.Uuid
  incidentAId           String    @map("incident_a_id") @db.Uuid
  incidentA             Incident  @relation("IncidentLinkA", fields: [incidentAId], references: [id], onDelete: Cascade)
  incidentBId           String    @map("incident_b_id") @db.Uuid
  incidentB             Incident  @relation("IncidentLinkB", fields: [incidentBId], references: [id], onDelete: Cascade)
  score                 Decimal   @db.Decimal(5, 4)
  deterministicSignals  Json      @map("deterministic_signals")
  aiRationale           String?   @map("ai_rationale") @db.Text
  status                String    @default("suggested")
  decidedByUserId       String?   @map("decided_by_user_id") @db.Uuid
  decidedBy             User?     @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt             DateTime? @map("decided_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@unique([incidentAId, incidentBId], map: "incident_link_suggestions_pair_unique")
  @@index([incidentAId], map: "incident_link_suggestions_incident_a_idx")
  @@index([incidentBId], map: "incident_link_suggestions_incident_b_idx")
  @@index([status], map: "incident_link_suggestions_status_idx")
  @@map("incident_link_suggestions")
}

model AiTranslationCache {
  id             String   @id @default(uuid()) @db.Uuid
  sourceType     String   @map("source_type") @db.VarChar(50)
  sourceId       String   @map("source_id") @db.Uuid
  sourceField    String   @map("source_field") @db.VarChar(100)
  sourceLanguage String   @map("source_language") @db.VarChar(10)
  targetLanguage String   @map("target_language") @db.VarChar(10)
  translatedText String   @map("translated_text") @db.Text
  modelVersion   String   @map("model_version") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([sourceType, sourceId, sourceField, targetLanguage], map: "ai_translation_cache_unique")
  @@index([sourceType, sourceId], map: "ai_translation_cache_source_idx")
  @@map("ai_translation_cache")
}

/// Mesh v2 sender. Stores ONLY SHA-256 of the 32-byte senderKey, never the key itself.
model SosSender {
  id            String            @id @default(uuid()) @db.Uuid
  senderKeyHash String            @unique @map("sender_key_hash") @db.Char(64)
  createdAt     DateTime          @default(now()) @map("created_at")
  lastSeenAt    DateTime          @default(now()) @map("last_seen_at")
  messages      SosMessage[]
  incidents     Incident[]
  profile       SosSenderProfile?

  @@map("sos_senders")
}

/// Latest onboarding profile per sender, AES-256-GCM encrypted at rest. One row per sender (no per-message copies).
model SosSenderProfile {
  senderId        String    @id @map("sender_id") @db.Uuid
  sender          SosSender @relation(fields: [senderId], references: [id], onDelete: Cascade)
  ciphertext      String    @db.Text
  keyVersion      String    @map("key_version") @db.VarChar(16)
  /// seq of the SOS that carried this profile; older profiles never overwrite newer ones.
  sourceSeq       BigInt    @map("source_seq")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("sos_sender_profiles")
}
