{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sosmesh.local/schemas/sos-message.schema.json",
  "title": "SOSMesh SOS Message",
  "type": "object",
  "required": ["version", "id", "envelope", "encryptedPayload"],
  "properties": {
    "version": {
      "$ref": "common.schema.json#/definitions/version"
    },
    "id": {
      "$ref": "common.schema.json#/definitions/uuid"
    },
    "envelope": {
      "type": "object",
      "required": ["timestamp", "locationStatus", "priority", "ackLevel"],
      "properties": {
        "timestamp": {
          "$ref": "common.schema.json#/definitions/timestamp"
        },
        "locationStatus": {
          "$ref": "common.schema.json#/definitions/locationStatus"
        },
        "location": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["latitude", "longitude"],
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "accuracy": {
                  "oneOf": [
                    { "type": "null" },
                    { "$ref": "common.schema.json#/definitions/accuracy" }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=highest, 5=lowest"
        },
        "ackLevel": {
          "$ref": "common.schema.json#/definitions/ackLevel"
        },
        "relayCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of relay hops"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "locationStatus": { "const": "UNKNOWN" } },
            "required": ["locationStatus"]
          },
          "then": {
            "properties": {
              "location": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "locationStatus": { "enum": ["GPS", "MANUAL"] } },
            "required": ["locationStatus"]
          },
          "then": {
            "required": ["location"],
            "properties": {
              "location": {
                "type": "object",
                "not": { "type": "null" }
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "description": "Public envelope visible to relays"
    },
    "encryptedPayload": {
      "type": "string",
      "minLength": 1,
      "description": "Encrypted sensitive message text, opaque to relays"
    },
    "signature": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" }
      ],
      "description": "Message signature for integrity"
    }
  },
  "additionalProperties": false
}
