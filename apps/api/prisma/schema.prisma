generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Aligns with packages/fixtures/transport/state-transitions.json (DeliveryStateMachine).
enum DeliveryState {
  LOCAL_SAVED
  PEER_RECEIVED
  SERVER_ACCEPTED
  OPERATOR_SEEN
  CASE_IN_PROGRESS
  FAILED
  EXPIRED
}

/// packages/contracts/schemas/common.schema.json#/definitions/incidentState
enum IncidentState {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

/// ADR-011 (feature branch): UNKNOWN/GPS/MANUAL — TODO sync enum when contract lands on main.
enum LocationStatus {
  UNKNOWN
  GPS
  MANUAL
}

/// SOS category — TODO bind to packages/contracts when SOS type schema is on main.
enum SosType {
  GENERAL
  MEDICAL
  TRAPPED
  FIRE
  OTHER
}

enum UserRole {
  OPERATOR
  ADMIN
  COORDINATOR
}

enum ResourceKind {
  FIELD_TEAM
  VEHICLE
  EQUIPMENT
  SHELTER
}

enum WorkTaskStatus {
  PROPOSED
  ASSIGNED
  ACCEPTED
  WITHDRAWN
  CLOSED
}

enum WorkTaskSource {
  MANUAL
  AI
}

enum NotificationDeliveryState {
  PENDING
  DELIVERED
  SKIPPED_QUIET_HOURS
  FAILED
}

enum OperatorReviewStatus {
  NEW
  SEEN
  UNDER_REVIEW
  COORDINATING
}

model Incident {
  id            String               @id @default(uuid()) @db.Uuid
  state         IncidentState        @default(PENDING)
  reviewStatus  OperatorReviewStatus @default(NEW) @map("review_status")
  version       Int                  @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  sosMessages SosMessage[]
  assignments Assignment[]
  aiAnalyses  AiAnalysis[]
  auditLogs   AuditLog[]
  workTasks   WorkTask[]

  @@map("incidents")
}

model SosMessage {
  id                  String         @id @default(uuid()) @db.Uuid
  messageId           String         @unique @map("message_id")
  incidentId          String         @map("incident_id") @db.Uuid
  incident            Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  deliveryState       DeliveryState  @default(LOCAL_SAVED) @map("delivery_state")
  sosType             SosType        @default(GENERAL) @map("sos_type")
  locationStatus      LocationStatus @default(UNKNOWN) @map("location_status")
  latitude            Decimal?       @db.Decimal(10, 7)
  longitude           Decimal?       @db.Decimal(10, 7)
  accuracyMeters      Float?         @map("accuracy_meters")
  /// Sensitive note: encrypted/opaque at rest (ADIM 9); must not appear in logs.
  encryptedNoteBlob   String?        @map("encrypted_note_blob") @db.Text
  encryptedPayloadRef String?        @map("encrypted_payload_ref")
  personCount         Int?           @map("person_count")
  /// Synthetic operator-visible SOS text (M0 fixtures); not raw PII from devices.
  operatorDisplayText String?        @map("operator_display_text") @db.Text
  priority            Int            @default(3)
  receivedAt          DateTime       @default(now()) @map("received_at")
  serverReceiptAt     DateTime?      @map("server_receipt_at")
  needsHumanReview    Boolean        @default(false) @map("needs_human_review")
  packetHash          String?        @map("packet_hash") @db.VarChar(64)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  messageEvents       MessageEvent[]
  relayReceipts       RelayReceipt[]

  @@index([incidentId])
  @@index([priority, receivedAt(sort: Desc)], map: "sos_messages_priority_received_at_idx")
  @@index([receivedAt(sort: Desc)], map: "sos_messages_received_at_idx")
  @@map("sos_messages")
}

model MessageEvent {
  id            String        @id @default(uuid()) @db.Uuid
  sosMessageId  String        @map("message_id") @db.Uuid
  sosMessage    SosMessage    @relation(fields: [sosMessageId], references: [id], onDelete: Cascade)
  deliveryState DeliveryState @map("delivery_state")
  source        String
  createdAt     DateTime      @default(now()) @map("created_at")
  metadataJson  Json?         @map("metadata_json")

  @@index([sosMessageId, createdAt])
  @@map("message_events")
}

model RelayReceipt {
  id           String     @id @default(uuid()) @db.Uuid
  sosMessageId String     @map("message_id") @db.Uuid
  sosMessage   SosMessage @relation(fields: [sosMessageId], references: [id], onDelete: Cascade)
  relayId      String     @map("relay_id")
  receivedAt   DateTime   @default(now()) @map("received_at")
  hopCount     Int        @default(0) @map("hop_count")
  receiptHash  String?    @map("receipt_hash")

  @@unique([sosMessageId, relayId])
  @@map("relay_receipts")
}

model AiAnalysis {
  id           String   @id @default(uuid()) @db.Uuid
  incidentId   String   @map("incident_id") @db.Uuid
  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  modelVersion String   @map("model_version")
  resultJson   Json     @map("result_json")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([incidentId])
  @@map("ai_analyses")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  teams     Team[]
  resources Resource[]

  @@map("organizations")
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  zoneCode       String?      @map("zone_code")
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")
  users          User[]
  assignments    Assignment[]
  resources      Resource[]
  workTasks      WorkTask[]
  locationShares LocationShareGrant[]

  @@index([organizationId])
  @@map("teams")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  displayName  String       @map("display_name")
  passwordHash String?      @map("password_hash")
  role         UserRole     @default(OPERATOR)
  teamId       String?      @map("team_id") @db.Uuid
  team        Team?        @relation(fields: [teamId], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  assignments     Assignment[]
  auditLogs       AuditLog[]
  workTasksOwned  WorkTask[]             @relation("WorkTaskAssignee")
  locationShares  LocationShareGrant[]
  notifications   OperatorNotification[]
  notifyPrefs     NotificationPreference?

  @@map("users")
}

model Assignment {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  teamId     String   @map("team_id") @db.Uuid
  team       Team     @relation(fields: [teamId], references: [id])
  assigneeId String?  @map("assignee_id") @db.Uuid
  assignee   User?    @relation(fields: [assigneeId], references: [id])
  status     String   @default("OPEN")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([incidentId])
  @@index([teamId])
  @@map("assignments")
}

model Resource {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  teamId         String?      @map("team_id") @db.Uuid
  team           Team?        @relation(fields: [teamId], references: [id])
  kind           ResourceKind
  name           String
  capacity       Int          @default(1)
  zoneCode       String?      @map("zone_code")
  availableFrom  DateTime?    @map("available_from")
  availableUntil DateTime?    @map("available_until")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  workTasks      WorkTask[]

  @@index([organizationId])
  @@index([teamId])
  @@map("resources")
}

model WorkTask {
  id          String         @id @default(uuid()) @db.Uuid
  incidentId  String         @map("incident_id") @db.Uuid
  incident    Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  teamId      String         @map("team_id") @db.Uuid
  team        Team           @relation(fields: [teamId], references: [id])
  resourceId  String?        @map("resource_id") @db.Uuid
  resource    Resource?      @relation(fields: [resourceId], references: [id])
  assigneeId  String?        @map("assignee_id") @db.Uuid
  assignee    User?          @relation("WorkTaskAssignee", fields: [assigneeId], references: [id])
  title       String
  description String?        @db.Text
  status      WorkTaskStatus @default(PROPOSED)
  source      WorkTaskSource @default(MANUAL)
  version     Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([incidentId])
  @@index([teamId])
  @@index([status])
  @@map("work_tasks")
}

/// Time-limited operator location share (no coordinates in audit_logs).
model LocationShareGrant {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String    @map("team_id") @db.Uuid
  team      Team      @relation(fields: [teamId], references: [id])
  expiresAt DateTime  @map("expires_at")
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)

  @@index([userId, expiresAt])
  @@index([teamId])
  @@map("location_share_grants")
}

model OperatorNotification {
  id             String                    @id @default(uuid()) @db.Uuid
  userId         String                    @map("user_id") @db.Uuid
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String                    @map("organization_id") @db.Uuid
  dedupeKey      String                    @map("dedupe_key")
  eventType      String                    @map("event_type")
  title          String
  body           String                    @db.Text
  deliveryState  NotificationDeliveryState @default(PENDING) @map("delivery_state")
  readAt         DateTime?                 @map("read_at")
  createdAt      DateTime                  @default(now()) @map("created_at")

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("operator_notifications")
}

model NotificationPreference {
  userId           String  @id @map("user_id") @db.Uuid
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppEnabled     Boolean @default(true) @map("in_app_enabled")
  emailEnabled     Boolean @default(false) @map("email_enabled")
  quietHoursStart  Int?    @map("quiet_hours_start")
  quietHoursEnd    Int?    @map("quiet_hours_end")
  timezoneOffsetMin Int    @default(180) @map("timezone_offset_min")

  @@map("notification_preferences")
}

model NotificationSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventType String   @map("event_type")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, eventType])
  @@map("notification_subscriptions")
}

model OperatorFeedEvent {
  seq            BigInt         @id @default(autoincrement())
  messageId      String         @map("message_id")
  incidentId     String         @map("incident_id") @db.Uuid
  priority       Int
  locationStatus LocationStatus @map("location_status")
  latitude       Decimal?       @db.Decimal(10, 7)
  longitude      Decimal?       @db.Decimal(10, 7)
  occurredAt     DateTime       @map("occurred_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@unique([messageId])
  @@index([seq])
  @@map("operator_feed_events")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorId     String?   @map("actor_id") @db.Uuid
  actor       User?     @relation(fields: [actorId], references: [id])
  incidentId  String?   @map("incident_id") @db.Uuid
  incident    Incident? @relation(fields: [incidentId], references: [id])
  action      String
  detailsJson Json?     @map("details_json")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([incidentId])
  @@index([createdAt])
  @@map("audit_logs")
}
