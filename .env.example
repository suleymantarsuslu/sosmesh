# SOSMesh Environment Variables Template
# Copy to .env locally. Production/staging values live in secret manager only — never commit .env.

# --- Deployment profile (ADIM 54) ---
SOSMESH_ENV=development
SOSMESH_CLOUD_PROFILE=generic
SOSMESH_CLOUD_CONFIG_PATH=infra/deploy/config/cloud-provider.yaml

# --- Database (separate instance per environment) ---
DATABASE_URL=

# --- Redis (optional) ---
REDIS_URL=

# --- API ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGINS=

# --- Meta AI (server-side only; MODEL_API_KEY from secret manager) ---
AI_ENABLED=
MODEL_API_KEY=
META_BASE_URL=
META_MODEL=
META_MAX_TOKENS=
META_TIMEOUT_MS=
META_MAX_RETRIES=
META_CIRCUIT_FAILURE_THRESHOLD=
META_CIRCUIT_COOLDOWN_MS=
AI_TENANT_RATE_LIMIT_MAX=
AI_TENANT_RATE_LIMIT_WINDOW_MS=
AI_DAILY_COST_CAP_USD=
AI_ESTIMATED_COST_USD=

# --- Auth / crypto (generate locally or inject from secret manager) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
INGEST_RECEIPT_SIGNING_PRIVATE_KEY=

# --- Ingest guards ---
INGEST_RATE_LIMIT_MAX=
INGEST_RATE_LIMIT_WINDOW_MS=

# --- Retention worker (optional separate process) ---
RETENTION_JOB_ENABLED=
RETENTION_SOS_MESSAGE_MAX_AGE_SECONDS=
WORKER_HEALTH_PORT=
WORKER_RETENTION_INTERVAL_MS=

# --- Web (public config only — no secrets) ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TEST_MODE=

# --- Push (optional; secret manager) ---
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=

# --- Observability (ADIM 48; /metrics fail-closed without bearer) ---
METRICS_SCRAPE_AUTH=
OTEL_EXPORTER_OTLP_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_CONSOLE_EXPORT=false

# --- Operator demo login (dev/staging synthetic accounts only) ---
OPERATOR_DEMO_PASSWORD=

# --- Staging compose smoke (CI generates ephemeral values; do not commit) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
