<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template — archive-export.sh copies to build/ExportOptions.plist and substitutes
  __SOSMESH_APPLE_TEAM_ID__, __SOSMESH_BUNDLE_ID_*__, and profile name placeholders (never commit real team ID).
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>__SOSMESH_APPLE_TEAM_ID__</string>
	<key>uploadSymbols</key>
	<true/>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>__SOSMESH_BUNDLE_ID_IOS__</key>
		<string>__SOSMESH_IOS_PROFILE_NAME__</string>
		<key>__SOSMESH_BUNDLE_ID_WATCH__</key>
		<string>__SOSMESH_WATCH_PROFILE_NAME__</string>
		<key>__SOSMESH_BUNDLE_ID_WIDGETS__</key>
		<string>__SOSMESH_WIDGET_PROFILE_NAME__</string>
	</dict>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
