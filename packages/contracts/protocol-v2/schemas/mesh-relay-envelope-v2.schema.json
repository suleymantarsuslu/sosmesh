{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sosmesh.dev/schemas/mesh-relay-envelope-v2.schema.json",
  "title": "MeshRelayEnvelopeV2",
  "description": "Opaque multihop relay envelope (protocol v2). Relay nodes MUST NOT decrypt opaqueCiphertextBase64.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "messageId",
    "hopCount",
    "maxHops",
    "ttlHops",
    "copyCount",
    "maxCopyCount",
    "originCreatedAt",
    "opaqueCiphertextBase64",
    "hopChainReceipt"
  ],
  "properties": {
    "protocolVersion": {
      "const": 2
    },
    "messageId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "hopCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "maxHops": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "ttlHops": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "copyCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "maxCopyCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "originCreatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "opaqueCiphertextBase64": {
      "type": "string",
      "minLength": 4
    },
    "hopChainReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relayDeviceIdHashes"],
      "properties": {
        "relayDeviceIdHashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "maxItems": 32
        }
      }
    },
    "peerAckHint": {
      "type": "string",
      "enum": ["PEER_RECEIVED_ONLY"]
    }
  }
}
