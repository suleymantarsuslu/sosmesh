# SOSMesh Environment Variables Template
# Copy to .env locally. Production/staging values live in secret manager only — never commit .env.

# --- Deployment profile (ADIM 54) ---
SOSMESH_ENV=development
SOSMESH_CLOUD_PROFILE=generic
SOSMESH_CLOUD_CONFIG_PATH=infra/deploy/config/cloud-provider.yaml

# --- Database (separate instance per environment) ---
DATABASE_URL=

# --- Redis (optional) ---
REDIS_URL=

# --- API ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGINS=

# --- Meta AI (server-side only; MODEL_API_KEY from secret manager) ---
AI_ENABLED=false
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_ASR_MODEL=muse-voice-transcribe-1.0
META_SAM_MODEL=sam-3.1
META_MAX_TOKENS=4096
META_TIMEOUT_MS=15000
META_MAX_RETRIES=2
META_CIRCUIT_FAILURE_THRESHOLD=3
META_CIRCUIT_COOLDOWN_MS=30000
AI_TENANT_RATE_LIMIT_MAX=30
AI_TENANT_RATE_LIMIT_WINDOW_MS=60000
AI_DAILY_BUDGET_USD=30
AI_TOTAL_BUDGET_USD=150
AI_ESTIMATED_COST_USD=0.002

# --- Media storage (attachments: audio/photo) ---
MEDIA_STORAGE_DIR=/tmp/sosmesh-media

# --- SOS encryption (production server key; optional) ---
SOSMESH_SERVER_SOS_PRIVATE_KEY=
SOSMESH_SERVER_SOS_KEY_ID=

# --- Auth / crypto (generate locally or inject from secret manager) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
INGEST_RECEIPT_SIGNING_PRIVATE_KEY=

# --- Ingest guards ---
INGEST_RATE_LIMIT_MAX=
INGEST_RATE_LIMIT_WINDOW_MS=

# --- Retention worker (optional separate process) ---
RETENTION_JOB_ENABLED=
RETENTION_SOS_MESSAGE_MAX_AGE_SECONDS=
WORKER_HEALTH_PORT=
WORKER_RETENTION_INTERVAL_MS=

# --- Web (public config only — no secrets) ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TEST_MODE=

# --- Push (optional; secret manager) ---
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=

# --- Observability (ADIM 48; /metrics fail-closed without bearer) ---
METRICS_SCRAPE_AUTH=
OTEL_EXPORTER_OTLP_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_CONSOLE_EXPORT=false

# --- Operator demo login (dev/staging synthetic accounts only) ---
OPERATOR_DEMO_PASSWORD=

# Android release signing (local/CI only — never commit keystore or passwords)
# Used by apps/android/app/build.gradle.kts when set; otherwise release is unsigned unless
# -Psosmesh.allowDebugSignedRelease=true (CI/local only).
# SOSMESH_RELEASE_STORE_FILE=
# SOSMESH_RELEASE_STORE_PASSWORD=
# SOSMESH_RELEASE_KEY_ALIAS=
# SOSMESH_RELEASE_KEY_PASSWORD=
# Gradle alternative: sosmesh.release.storeFile, sosmesh.release.storePassword, etc. in ~/.gradle/gradle.properties

# --- Staging compose smoke (CI generates ephemeral values; do not commit) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
