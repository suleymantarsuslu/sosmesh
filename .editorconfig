# EditorConfig: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,ts,tsx,jsx,json,yaml,yml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.{kt,kts}]
indent_size = 4

[*.swift]
indent_size = 4

[*.gradle]
indent_size = 2

[Makefile]
indent_style = tab
