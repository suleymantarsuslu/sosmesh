# nginx TLS reverse proxy template (staging).
# Replace ${TLS_CERT_PATH}, ${TLS_KEY_PATH}, ${STAGING_HOST} before reload.
# Status: hazır, uygulanmadı (BLOCKED_APPROVAL) — real certs/DNS not provisioned in ADIM 54.

upstream sosmesh_api {
  server api:3001;
  keepalive 8;
}

upstream sosmesh_web {
  server web:3000;
  keepalive 8;
}

server {
  listen 443 ssl http2;
  server_name ${STAGING_HOST};

  ssl_certificate     ${TLS_CERT_PATH};
  ssl_certificate_key ${TLS_KEY_PATH};
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location /health {
    proxy_pass http://sosmesh_api/health;
    proxy_http_version 1.1;
    access_log off;
  }

  location /health/ready {
    proxy_pass http://sosmesh_api/health/ready;
    proxy_http_version 1.1;
    access_log off;
  }

  location /v1/ {
    proxy_pass http://sosmesh_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    proxy_pass http://sosmesh_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 80;
  server_name ${STAGING_HOST};
  return 301 https://$host$request_uri;
}
