# SOSMesh Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Database
DATABASE_URL=postgresql://sosmesh:<set-locally>@localhost:5432/sosmesh

# Redis (optional for M0)
REDIS_URL=redis://localhost:6379

# API
PORT=3001
NODE_ENV=development

# Meta AI API (M0 için gerekli)
# https://developers.facebook.com/docs/llama-api/
MODEL_API_KEY=

# JWT Secrets (development için placeholder, production'da güçlü değer kullan)
JWT_SECRET=<set-locally>
JWT_REFRESH_SECRET=<set-locally>

# Web App
NEXT_PUBLIC_API_URL=http://localhost:3001

# Push Notifications (FCM/APNS - opsiyonel)
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=

# Logging
LOG_LEVEL=debug

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
