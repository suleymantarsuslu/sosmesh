{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sosmesh.dev/schemas/tombstone-batch-v2.schema.json",
  "title": "TombstoneBatchV2",
  "description": "BLE transfer payload (central -> peripheral) carrying delivery tombstones. JSON, <= 4096 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "v", "items"],
  "properties": {
    "kind": { "const": "TOMBSTONES" },
    "v": { "const": 2 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "delivery-tombstone-v2.schema.json" }
    }
  }
}
