# Local / CI backup configuration (no secrets in repo).
# Copy to your secret manager or export in the shell before running scripts.

# Human-readable secret name only — actual key material lives outside git/logs.
SOSMESH_BACKUP_ENCRYPTION_KEY_SECRET_NAME=sosmesh-backup-aes256

# 32-byte key as base64 (set in env at runtime; never commit).
# SOSMESH_BACKUP_ENCRYPTION_KEY=

# Restricted local storage root (CI: ephemeral runner dir; compose: volume mount).
SOSMESH_BACKUP_STORAGE_DIR=/var/lib/sosmesh/backups

# WAL archive subdirectory (relative to SOSMESH_BACKUP_STORAGE_DIR).
SOSMESH_BACKUP_WAL_SUBDIR=wal

# Base backup subdirectory.
SOSMESH_BACKUP_BASE_SUBDIR=base

# Retention: keep at most N base backups and WAL files older than N days.
SOSMESH_BACKUP_RETENTION_MAX_BASE=7
SOSMESH_BACKUP_RETENTION_WAL_DAYS=7

# PostgreSQL connection for backup scripts (admin URL with CREATEDB if needed).
# SOSMESH_BACKUP_PG_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
